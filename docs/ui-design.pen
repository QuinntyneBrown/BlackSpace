              "children": [
                {
                  "type": "text",
                  "id": "oaTZE",
                  "name": "probP1",
                  "fill": "#8A8A9A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Canada's space and defence sector supports over 12,000 jobs and is growing fast — Canadarm3, Lunar Gateway, defence modernization, satellite programs. Billions in investment are reshaping the industry.",
                  "lineHeight": 1.7,
                  "textAlign": "center",
                  "fontFamily": "Inter",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "VMfbO",
                  "name": "probP2",
                  "fill": "#8A8A9A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Black Canadians are already part of this work. But without dedicated networks, visibility remains low and pathways for the next generation stay narrow. No organization exists specifically for Black Canadian engineers and technologists in space and defence.",
                  "lineHeight": 1.7,
                  "textAlign": "center",
                  "fontFamily": "Inter",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },

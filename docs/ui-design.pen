              "fill": "#FFFFFF",
              "textGrowth": "fixed-width",
              "width": 800,
              "content": "The talent is here.\nThe network wasn't.",
              "lineHeight": 1.15,
              "textAlign": "center",
              "fontFamily": "Sora",
              "fontSize": 40,
              "fontWeight": "700",
